<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ site.name | default: "Capitol City Pest Solutions" }} — Des Moines pest control</title>
  <meta name="description" content="{{ site.description | default: "Reliable pest control for homes and businesses in Des Moines, IA." }}">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

<header class="site-header" id="site-header">
  <div class="shell header-inner">
    <a class="brand-lock" href="/">
      <img src="/assets/logo.svg" width="36" height="36" alt="">
      <div class="brand-text">
        <span class="brand-name">Capitol City Pest</span>
        <span class="brand-tag">Solutions · Des Moines</span>
      </div>
    </a>
    <nav class="site-nav" aria-label="Primary">
      <a href="/" class="nav-link is-current">Home</a>
      <a href="/services/" class="nav-link">Services</a>
      <a href="/about/" class="nav-link">About</a>
      <a href="/service-areas/" class="nav-link">Service Areas</a>
      <a href="/contact/" class="nav-link">Contact</a>
    </nav>
    <div class="header-actions">
      <a href="tel:5155550174" class="phone-pill">
        <span class="phone-dot" aria-hidden="true"></span>
        <span class="phone-num">(515) 555-0174</span>
      </a>
      <a href="/contact/" class="btn btn-primary">Free quote <span class="arr">→</span></a>
    </div>
  </div>
</header>

<main>

  <!-- ============================================================
       HERO
       ============================================================ -->
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy-col">
        <span class="eyebrow">Des Moines · since 2012</span>
        <h1 class="hero-title">
          Pest problems, handled <span class="hero-em">properly</span>.
        </h1>
        <p class="hero-lead">
          Capitol City Pest Solutions has served the greater Des Moines area for over a decade. Whether you're dealing with a one-time invasion or need year-round protection, our licensed technicians get the job done safely and effectively.
        </p>
        <div class="hero-actions">
          <a href="/contact/" class="btn btn-primary btn-lg">Get a free quote <span class="arr">→</span></a>
          <a href="tel:5155550174" class="btn btn-secondary btn-lg">Call (515) 555-0174</a>
        </div>
        <ul class="hero-trust">
          <li>
            <svg class="check-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            EPA-registered products
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Iowa-licensed technicians
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Same-day service available
          </li>
        </ul>
      </div>
      <aside class="offer-card" aria-label="Free inspection offer">
        <div class="offer-stripe"></div>
        <div class="offer-body">
          <span class="eyebrow">Free quote</span>
          <h2 class="offer-title">Most inspections are free.</h2>
          <p class="offer-copy">We'll let you know before we visit if there's a charge — no surprises. Inspections take 30–60 minutes; you'll get a written report and a clear recommendation before any paid work.</p>
          <dl class="offer-stats">
            <div><dt>Average response</dt><dd>Under 24h</dd></div>
            <div><dt>Inspection</dt><dd>30–60 min</dd></div>
            <div><dt>Warranty</dt><dd>1 year</dd></div>
          </dl>
          <a href="/contact/" class="btn btn-cta btn-block">Schedule an inspection <span class="arr">→</span></a>
        </div>
      </aside>
    </div>
  </section>

  <!-- ============================================================
       SERVICES GRID
       ============================================================ -->
  <section class="services" id="services">
    <div class="shell">
      <div class="section-head">
        <span class="eyebrow">Services</span>
        <h2 class="section-title">Full-service pest control, tailored to Iowa.</h2>
        <p class="section-lead">Every service starts with a thorough inspection and ends with a clear prevention plan.</p>
      </div>
      <ul class="service-grid">
        <li>
          <a class="service-tile" href="/services/general-pest-control/">
            <span class="service-rule" aria-hidden="true"></span>
            <span class="service-icon-wrap"><img src="/assets/icons/services/ant.svg" width="40" height="40" alt=""></span>
            <h3 class="service-title">General Pest Control</h3>
            <p class="service-blurb">Interior and exterior treatment for ants, spiders, cockroaches, and more.</p>
            <span class="service-cta">Learn more <span class="arr">→</span></span>
          </a>
        </li>
        <li>
          <a class="service-tile" href="/services/rodent-control/">
            <span class="service-rule" aria-hidden="true"></span>
            <span class="service-icon-wrap"><img src="/assets/icons/services/mouse.svg" width="40" height="40" alt=""></span>
            <h3 class="service-title">Rodent Control</h3>
            <p class="service-blurb">Trapping, exclusion, and prevention for mice and rats.</p>
            <span class="service-cta">Learn more <span class="arr">→</span></span>
          </a>
        </li>
        <li>
          <a class="service-tile" href="/services/termite-treatment/">
            <span class="service-rule" aria-hidden="true"></span>
            <span class="service-icon-wrap"><img src="/assets/icons/services/termite.svg" width="40" height="40" alt=""></span>
            <h3 class="service-title">Termite Treatment</h3>
            <p class="service-blurb">Liquid barrier and baiting systems to protect your structure.</p>
            <span class="service-cta">Learn more <span class="arr">→</span></span>
          </a>
        </li>
        <li>
          <a class="service-tile" href="/services/bed-bug-treatment/">
            <span class="service-rule" aria-hidden="true"></span>
            <span class="service-icon-wrap"><img src="/assets/icons/services/bed-bug.svg" width="40" height="40" alt=""></span>
            <h3 class="service-title">Bed Bug Treatment</h3>
            <p class="service-blurb">Heat and chemical treatments that eliminate bed bugs for good.</p>
            <span class="service-cta">Learn more <span class="arr">→</span></span>
          </a>
        </li>
        <li>
          <a class="service-tile" href="/services/mosquito-control/">
            <span class="service-rule" aria-hidden="true"></span>
            <span class="service-icon-wrap"><img src="/assets/icons/services/mosquito.svg" width="40" height="40" alt=""></span>
            <h3 class="service-title">Mosquito Control</h3>
            <p class="service-blurb">Seasonal yard treatments so you can enjoy the outdoors again.</p>
            <span class="service-cta">Learn more <span class="arr">→</span></span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============================================================
       ABOUT BAND
       ============================================================ -->
  <section class="about-band" id="about">
    <div class="shell about-grid">
      <div class="rule-block about-copy">
        <span class="eyebrow">About</span>
        <h2>Local expertise. Real results.</h2>
        <p class="lead">Capitol City Pest Solutions was founded in Des Moines by a family that grew up here and wanted to build something they could be proud of. We started with a single truck and a commitment to honest pricing and thorough work — and we've grown by keeping that same standard every time we walk through a customer's door.</p>
        <p>We're not a national franchise. Every technician is Iowa-licensed, background-checked, and trained on the specific pest pressures that central Iowa homeowners and businesses face.</p>
      </div>
      <ul class="value-list">
        <li class="value-card">
          <span class="value-num">01</span>
          <div>
            <h4>Transparency</h4>
            <p>We explain what we found, what we're treating, and why. No upsells you don't need.</p>
          </div>
        </li>
        <li class="value-card">
          <span class="value-num">02</span>
          <div>
            <h4>Safety</h4>
            <p>EPA-registered products, label requirements followed to the letter. We tell you exactly what we applied and when it's safe to re-enter.</p>
          </div>
        </li>
        <li class="value-card">
          <span class="value-num">03</span>
          <div>
            <h4>Accountability</h4>
            <p>If a treatment doesn't work, we come back. That's not a marketing line — it's how we've kept customers for over a decade.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============================================================
       SERVICE AREAS
       ============================================================ -->
  <section class="areas" id="areas">
    <div class="shell">
      <div class="areas-grid">
        <div class="rule-block">
          <span class="eyebrow">Service areas</span>
          <h2>Greater Des Moines &amp; central Iowa.</h2>
          <p class="lead">We're based in Des Moines and serve customers throughout Polk County. Don't see your town? Call us — we're often able to accommodate locations not listed below.</p>
          <a href="/contact/" class="btn btn-secondary">Check availability for your address <span class="arr">→</span></a>
        </div>
        <ul class="area-chips">
          <li><span class="area-chip">Des Moines</span></li>
          <li><span class="area-chip">West Des Moines</span></li>
          <li><span class="area-chip">Ankeny</span></li>
          <li><span class="area-chip">Urbandale</span></li>
          <li><span class="area-chip">Johnston</span></li>
          <li><span class="area-chip">Clive</span></li>
          <li><span class="area-chip">Windsor Heights</span></li>
          <li><span class="area-chip">Pleasant Hill</span></li>
          <li><span class="area-chip">Altoona</span></li>
          <li><span class="area-chip">Bondurant</span></li>
          <li><span class="area-chip">Norwalk</span></li>
          <li><span class="area-chip">Waukee</span></li>
          <li><span class="area-chip">Grimes</span></li>
          <li><span class="area-chip">Polk City</span></li>
          <li><span class="area-chip">Alleman</span></li>
          <li><span class="area-chip">Mitchellville</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============================================================
       CONTACT CTA
       ============================================================ -->
  <section class="contact-cta" id="contact">
    <div class="shell contact-grid">
      <div class="contact-info">
        <span class="eyebrow">Get in touch</span>
        <h2 class="contact-title">Get a free quote.</h2>
        <p class="lead">We're happy to answer questions, schedule an inspection, or give you a ballpark estimate over the phone.</p>
        <dl class="contact-meta">
          <div class="contact-meta-row"><dt>Phone</dt><dd class="mono"><a href="tel:5155550174">(515) 555-0174</a></dd></div>
          <div class="contact-meta-row"><dt>Email</dt><dd class="mono"><a href="mailto:hello@capital-city-pest.example">hello@capital-city-pest.example</a></dd></div>
          <div class="contact-meta-row"><dt>Address</dt><dd>412 Elm Street<br>Des Moines, IA 50309</dd></div>
        </dl>
        <table class="hours-table">
          <tbody>
            <tr><th>Mon–Fri</th><td>7:00 AM – 6:00 PM</td></tr>
            <tr><th>Saturday</th><td>8:00 AM – 2:00 PM</td></tr>
            <tr><th>Sunday</th><td class="muted">Closed</td></tr>
          </tbody>
        </table>
      </div>
      <form class="contact-form" action="/contact/" method="POST">
        <span class="form-eyebrow">Quote request</span>
        <div class="field"><label for="name">Full name</label><input id="name" name="name" placeholder="Your name" required></div>
        <div class="form-row-2">
          <div class="field"><label for="phone">Phone</label><input id="phone" name="phone" inputmode="tel" placeholder="(515) 555-0174" class="mono"></div>
          <div class="field"><label for="zip">ZIP code</label><input id="zip" name="zip" inputmode="numeric" placeholder="50309" class="mono"></div>
        </div>
        <div class="field">
          <label for="service">What are you seeing?</label>
          <select id="service" name="service">
            <option value="general">General pest control</option>
            <option value="rodent">Rodent control</option>
            <option value="termite">Termite treatment</option>
            <option value="bedbug">Bed bug treatment</option>
            <option value="mosquito">Mosquito control</option>
            <option value="other">Not sure — help me identify it</option>
          </select>
        </div>
        <div class="field">
          <label for="notes">Anything else? <span class="optional">(optional)</span></label>
          <textarea id="notes" name="notes" rows="3" placeholder="When did you first notice it? Where in the home?"></textarea>
        </div>
        <button type="submit" class="btn btn-cta btn-block btn-lg">Request my free quote <span class="arr">→</span></button>
        <p class="form-fineprint">We'll never share your info. You'll get a written quote — no surprise charges.</p>
      </form>
    </div>
  </section>

</main>

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <a class="brand-lock brand-lock-dark" href="/">
        <img src="/assets/logo.svg" width="40" height="40" alt="">
        <div class="brand-text">
          <span class="brand-name">Capitol City Pest</span>
          <span class="brand-tag">Solutions · Des Moines</span>
        </div>
      </a>
      <p class="footer-tag">Reliable pest control for homes and businesses in Des Moines, IA. Iowa-licensed, EPA-registered, locally owned.</p>
    </div>
    <div class="footer-col">
      <span class="footer-eyebrow">Services</span>
      <ul>
        <li><a href="/services/general-pest-control/">General pest control</a></li>
        <li><a href="/services/rodent-control/">Rodent control</a></li>
        <li><a href="/services/termite-treatment/">Termite treatment</a></li>
        <li><a href="/services/bed-bug-treatment/">Bed bug treatment</a></li>
        <li><a href="/services/mosquito-control/">Mosquito control</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <span class="footer-eyebrow">Company</span>
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/service-areas/">Service areas</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <span class="footer-eyebrow">Reach us</span>
      <ul>
        <li><a href="tel:5155550174" class="mono">(515) 555-0174</a></li>
        <li><a href="mailto:hello@capital-city-pest.example" class="mono">hello@capital-city-pest.example</a></li>
        <li>412 Elm Street<br>Des Moines, IA 50309</li>
      </ul>
    </div>
  </div>
  <div class="shell footer-fineprint">
    <span>© {{ "now" | date: "%Y" }} Capitol City Pest Solutions, LLC.</span>
    <span class="mono">IA LICENSE #PCO-0000-PLACEHOLDER · EPA-REGISTERED</span>
  </div>
</footer>

<script>
  (function() {
    var hdr = document.getElementById('site-header');
    function onScroll() { hdr.classList.toggle('is-scrolled', window.scrollY > 8); }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>

</body>
</html>
